APP_ENV=development
SECRET_KEY=medikiosk-super-secret-key-change-in-production-2026
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medikiosk_db
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Google Gemini Primary)
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here

# Language Configuration (Bhashini Primary)
LANGUAGE_PROVIDER=mock
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_ULCA_API_KEY=your_bhashini_ulca_api_key

# OCR Configuration
OCR_PROVIDER=mock

# ABDM Configuration
ABDM_ENV=mock
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret

# Object Storage / Uploads
STORAGE_DIR=./uploads
